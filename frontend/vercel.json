{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ec2-54-78-124-210.eu-west-1.compute.amazonaws.com:8080/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}